create table public.therapist_schedule_settings (
  therapist_id uuid not null,
  timezone text not null default 'UTC'::text,
  slot_duration_minutes integer not null default 60,
  public_min_notice_hours integer not null default 24,
  public_max_days_ahead integer not null default 60,
  allow_public_booking boolean not null default true,
  default_room_id uuid null,
  weekly_schedule jsonb not null default '{}'::jsonb,
  created_at timestamp with time zone not null default now(),
  updated_at timestamp with time zone not null default now(),
  constraint therapist_schedule_settings_pkey primary key (therapist_id),
  constraint therapist_schedule_settings_default_room_id_fkey foreign KEY (default_room_id) references rooms (id),
  constraint therapist_schedule_settings_therapist_id_fkey foreign KEY (therapist_id) references therapist_profiles (therapist_id) on delete CASCADE
) TABLESPACE pg_default;

create trigger trg_tss_updated_at BEFORE
update on therapist_schedule_settings for EACH row
execute FUNCTION set_updated_at ();


create table public.therapist_profiles (
  therapist_id uuid not null,
  display_name text null,
  bio text null,
  specialties text[] not null default '{}'::text[],
  credentials text[] not null default '{}'::text[],
  is_active boolean not null default true,
  created_at timestamp with time zone not null default now(),
  updated_at timestamp with time zone not null default now(),
  constraint therapist_profiles_pkey primary key (therapist_id),
  constraint therapist_profiles_therapist_id_fkey foreign KEY (therapist_id) references profiles (id) on delete CASCADE
) TABLESPACE pg_default;

create trigger set_therapist_profiles_updated_at BEFORE
update on therapist_profiles for EACH row
execute FUNCTION set_updated_at ();


create table public.therapist_clients (
  id bigint generated always as identity not null,
  therapist_id uuid not null,
  client_id uuid not null,
  created_at timestamp with time zone not null default now(),
  constraint therapist_clients_pkey primary key (id),
  constraint therapist_clients_therapist_client_key unique (therapist_id, client_id),
  constraint therapist_clients_therapist_id_client_id_key unique (therapist_id, client_id),
  constraint therapist_clients_client_id_fkey foreign KEY (client_id) references profiles (id) on delete CASCADE,
  constraint therapist_clients_therapist_id_fkey foreign KEY (therapist_id) references profiles (id) on delete CASCADE
) TABLESPACE pg_default;


create table public.session_notes (
  id uuid not null default gen_random_uuid (),
  therapist_id uuid not null,
  client_id uuid not null,
  appointment_id uuid null,
  title text null,
  note text not null,
  client_visible boolean not null default false,
  created_at timestamp with time zone not null default now(),
  constraint session_notes_pkey primary key (id),
  constraint session_notes_appointment_id_fkey foreign KEY (appointment_id) references appointments (id) on delete set null,
  constraint session_notes_client_id_fkey foreign KEY (client_id) references profiles (id) on delete CASCADE,
  constraint session_notes_therapist_id_fkey foreign KEY (therapist_id) references profiles (id) on delete CASCADE
) TABLESPACE pg_default;


create table public.rooms (
  id uuid not null default gen_random_uuid (),
  name text not null,
  color text null,
  created_at timestamp with time zone not null default now(),
  constraint rooms_pkey primary key (id),
  constraint rooms_name_key unique (name)
) TABLESPACE pg_default;


create table public.room_blocks (
  id uuid not null default gen_random_uuid (),
  room_id uuid not null,
  start_time timestamp with time zone not null,
  end_time timestamp with time zone not null,
  reason text null,
  created_by uuid null,
  created_at timestamp with time zone not null default now(),
  updated_at timestamp with time zone not null default now(),
  constraint room_blocks_pkey primary key (id),
  constraint room_blocks_room_id_fkey foreign KEY (room_id) references rooms (id) on delete CASCADE,
  constraint room_blocks_time_check check ((start_time < end_time))
) TABLESPACE pg_default;

create index IF not exists idx_room_blocks_room_time on public.room_blocks using btree (room_id, start_time, end_time) TABLESPACE pg_default;

create trigger trg_room_blocks_updated_at BEFORE
update on room_blocks for EACH row
execute FUNCTION set_updated_at ();


create table public.recurring_series (
  id uuid not null default gen_random_uuid (),
  therapist_id uuid not null,
  client_id uuid not null,
  kind text not null,
  status text not null,
  start_time timestamp with time zone not null,
  duration_minutes integer not null,
  weekdays integer[] not null,
  until_date date not null,
  room_id uuid null,
  notes text null,
  created_at timestamp with time zone not null default now(),
  updated_at timestamp with time zone not null default now(),
  constraint recurring_series_pkey primary key (id),
  constraint recurring_series_client_id_fkey foreign KEY (client_id) references auth.users (id) on delete CASCADE,
  constraint recurring_series_room_id_fkey foreign KEY (room_id) references rooms (id) on delete set null,
  constraint recurring_series_therapist_id_fkey foreign KEY (therapist_id) references auth.users (id) on delete CASCADE,
  constraint recurring_series_duration_minutes_check check (
    (
      (duration_minutes > 0)
      and (duration_minutes <= 720)
    )
  ),
  constraint recurring_series_weekdays_check check ((weekdays <@ array[0, 1, 2, 3, 4, 5, 6]))
) TABLESPACE pg_default;

create trigger trg_recurring_series_updated_at BEFORE
update on recurring_series for EACH row
execute FUNCTION set_updated_at ();


create table public.profiles (
  id uuid not null,
  email text null,
  full_name text null,
  role public.user_role not null default 'client'::user_role,
  created_at timestamp with time zone not null default now(),
  updated_at timestamp with time zone not null default now(),
  constraint profiles_pkey primary key (id),
  constraint profiles_id_fkey foreign KEY (id) references auth.users (id) on delete CASCADE
) TABLESPACE pg_default;

create trigger prevent_role_change_trg BEFORE
update on profiles for EACH row
execute FUNCTION prevent_role_change ();

create trigger set_profiles_updated_at BEFORE
update on profiles for EACH row
execute FUNCTION set_updated_at ();



create table public.insurance_documents (
  id uuid not null default gen_random_uuid (),
  client_id uuid not null,
  provider text null,
  member_id text null,
  group_number text null,
  front_path text null,
  back_path text null,
  created_at timestamp with time zone not null default now(),
  constraint insurance_documents_pkey primary key (id),
  constraint insurance_documents_client_id_fkey foreign KEY (client_id) references profiles (id) on delete CASCADE
) TABLESPACE pg_default;




create table public.group_sessions (
  id uuid not null default gen_random_uuid (),
  therapist_id uuid not null,
  room_id uuid null,
  title text not null,
  description text null,
  start_time timestamp with time zone not null,
  end_time timestamp with time zone not null,
  capacity integer not null default 8,
  is_public boolean not null default true,
  status text not null default 'scheduled'::text,
  created_by uuid null,
  created_at timestamp with time zone not null default now(),
  updated_at timestamp with time zone not null default now(),
  constraint group_sessions_pkey primary key (id),
  constraint group_sessions_room_id_fkey foreign KEY (room_id) references rooms (id),
  constraint group_sessions_therapist_id_fkey foreign KEY (therapist_id) references therapist_profiles (therapist_id) on delete CASCADE,
  constraint group_sessions_capacity_check check ((capacity > 0)),
  constraint group_sessions_time_check check ((start_time < end_time))
) TABLESPACE pg_default;

create index IF not exists idx_group_sessions_time on public.group_sessions using btree (start_time, end_time) TABLESPACE pg_default;

create index IF not exists idx_group_sessions_room_time on public.group_sessions using btree (room_id, start_time, end_time) TABLESPACE pg_default;

create index IF not exists idx_group_sessions_therapist_time on public.group_sessions using btree (therapist_id, start_time, end_time) TABLESPACE pg_default;

create trigger trg_group_sessions_email
after INSERT
or DELETE
or
update on group_sessions for EACH row
execute FUNCTION trg_queue_group_session_emails ();

create trigger trg_group_sessions_updated_at BEFORE
update on group_sessions for EACH row
execute FUNCTION set_updated_at ();



create table public.group_session_participants (
  id bigint generated always as identity not null,
  group_session_id uuid not null,
  client_id uuid not null,
  status text not null default 'joined'::text,
  joined_at timestamp with time zone not null default now(),
  updated_at timestamp with time zone not null default now(),
  constraint group_session_participants_pkey primary key (id),
  constraint group_session_participants_group_session_id_client_id_key unique (group_session_id, client_id),
  constraint group_session_participants_group_session_id_fkey foreign KEY (group_session_id) references group_sessions (id) on delete CASCADE
) TABLESPACE pg_default;

create index IF not exists idx_gsp_session on public.group_session_participants using btree (group_session_id) TABLESPACE pg_default;

create index IF not exists idx_gsp_client on public.group_session_participants using btree (client_id) TABLESPACE pg_default;

create trigger trg_gsp_email
after INSERT
or DELETE
or
update on group_session_participants for EACH row
execute FUNCTION trg_queue_group_participant_emails ();

create trigger trg_gsp_updated_at BEFORE
update on group_session_participants for EACH row
execute FUNCTION set_updated_at ();




create table public.form_submissions (
  id uuid not null default gen_random_uuid (),
  client_id uuid not null,
  template_key text not null,
  responses jsonb not null default '{}'::jsonb,
  status text not null default 'draft'::text,
  submitted_at timestamp with time zone null,
  created_at timestamp with time zone not null default now(),
  updated_at timestamp with time zone not null default now(),
  constraint form_submissions_pkey primary key (id),
  constraint form_submissions_client_id_fkey foreign KEY (client_id) references profiles (id) on delete CASCADE
) TABLESPACE pg_default;

create trigger set_form_submissions_updated_at BEFORE
update on form_submissions for EACH row
execute FUNCTION set_updated_at ();



create table public.client_profiles (
  client_id uuid not null,
  display_name text null,
  created_at timestamp with time zone not null default now(),
  updated_at timestamp with time zone not null default now(),
  constraint client_profiles_pkey primary key (client_id),
  constraint client_profiles_client_id_fkey foreign KEY (client_id) references auth.users (id) on delete CASCADE
) TABLESPACE pg_default;

create trigger trg_client_profiles_updated_at BEFORE
update on client_profiles for EACH row
execute FUNCTION set_updated_at ();






create table public.availability_slots (
  id uuid not null default gen_random_uuid (),
  therapist_id uuid not null,
  start_time timestamp with time zone not null,
  end_time timestamp with time zone not null,
  is_booked boolean not null default false,
  booked_by_client_id uuid null,
  created_at timestamp with time zone not null default now(),
  room_id uuid null,
  is_public boolean not null default true,
  updated_at timestamp with time zone not null default now(),
  created_by uuid null,
  constraint availability_slots_pkey primary key (id),
  constraint availability_slots_booked_by_client_id_fkey foreign KEY (booked_by_client_id) references profiles (id) on delete set null,
  constraint availability_slots_room_id_fkey foreign KEY (room_id) references rooms (id),
  constraint availability_slots_therapist_id_fkey foreign KEY (therapist_id) references profiles (id) on delete CASCADE,
  constraint availability_slots_time_check check ((start_time < end_time))
) TABLESPACE pg_default;

create index IF not exists idx_availability_room_time on public.availability_slots using btree (room_id, start_time, end_time) TABLESPACE pg_default;

create index IF not exists idx_availability_therapist_time on public.availability_slots using btree (therapist_id, start_time, end_time) TABLESPACE pg_default;

create index IF not exists idx_availability_public on public.availability_slots using btree (is_public, is_booked, start_time) TABLESPACE pg_default;

create index IF not exists availability_slots_start_time_idx on public.availability_slots using btree (start_time) TABLESPACE pg_default;

create trigger trg_availability_slots_updated_at BEFORE
update on availability_slots for EACH row
execute FUNCTION set_updated_at ();



create table public.appointments (
  id uuid not null default gen_random_uuid (),
  therapist_id uuid not null,
  client_id uuid not null,
  start_time timestamp with time zone not null,
  end_time timestamp with time zone not null,
  status public.appointment_status not null default 'requested'::appointment_status,
  kind public.appointment_kind not null default 'consultation'::appointment_kind,
  availability_slot_id uuid null,
  created_at timestamp with time zone not null default now(),
  updated_at timestamp with time zone not null default now(),
  room_id uuid null,
  title text null,
  notes text null,
  series_id uuid null,
  created_by uuid null,
  updated_by uuid null,
  constraint appointments_pkey primary key (id),
  constraint appointments_client_id_fkey foreign KEY (client_id) references profiles (id) on delete CASCADE,
  constraint appointments_availability_slot_id_fkey foreign KEY (availability_slot_id) references availability_slots (id) on delete set null,
  constraint appointments_series_id_fkey foreign KEY (series_id) references recurring_series (id) on delete set null,
  constraint appointments_therapist_id_fkey foreign KEY (therapist_id) references profiles (id) on delete CASCADE,
  constraint appointments_room_id_fkey foreign KEY (room_id) references rooms (id),
  constraint appointments_time_check check ((start_time < end_time))
) TABLESPACE pg_default;

create index IF not exists idx_appointments_therapist_time on public.appointments using btree (therapist_id, start_time) TABLESPACE pg_default;

create index IF not exists idx_appointments_client_time on public.appointments using btree (client_id, start_time) TABLESPACE pg_default;

create index IF not exists idx_appointments_room_time on public.appointments using btree (room_id, start_time, end_time) TABLESPACE pg_default;

create index IF not exists appointments_start_time_idx on public.appointments using btree (start_time) TABLESPACE pg_default;

create index IF not exists appointments_therapist_time_idx on public.appointments using btree (therapist_id, start_time) TABLESPACE pg_default;

create index IF not exists appointments_room_time_idx on public.appointments using btree (room_id, start_time) TABLESPACE pg_default;

create trigger set_appointments_updated_at BEFORE
update on appointments for EACH row
execute FUNCTION set_updated_at ();

create trigger trg_appointments_email
after INSERT
or DELETE
or
update on appointments for EACH row
execute FUNCTION trg_queue_appointment_emails ();

create trigger trg_appointments_updated_at BEFORE
update on appointments for EACH row
execute FUNCTION set_updated_at ();

